# Datos crudos (pueden ser pesados o tener restricciones de redistribución)
data/raw/*
!data/raw/.gitkeep

# Datos procesados: SÍ se trackean los CSVs (son chicos, ~2 MB) para que la app
# arranque al clonar sin tener que copiar data/raw/ (2.6 GB).
# Si aquí caen archivos pesados en el futuro, ignóralos explícitamente.

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Entornos virtuales
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# IDEs
.vscode/
.idea/
*.swp
.DS_Store

# Modelos / checkpoints (pueden ser muy pesados)
models/
checkpoints/
*.bin
*.safetensors
*.pt
*.ckpt

# Streamlit
.streamlit/secrets.toml

# Logs y artefactos temporales
*.log
tmp/
